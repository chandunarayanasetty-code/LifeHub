# Copy to .env.local for local development: cp .env.example .env.local
#
# Everything below is optional. With no configuration at all, LifeHub runs an
# embedded PostgreSQL (PGlite) database in .data/pglite and seeds a clearly
# labelled demo workspace, so `npm run dev` works with zero setup.

# ---------------------------------------------------------------- database ---
# Leave this unset to use the embedded database.
# Set it to a real PostgreSQL server (Neon, Supabase, RDS, Docker, local pg)
# for anything you intend to deploy, then run `npm run db:migrate` once.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lifehub?sslmode=require"

# Where the embedded database stores its files. Useful for running a second
# isolated instance (the Playwright suite sets this automatically).
# LIFEHUB_DATA_DIR=".data/pglite"

# Create the demo account even in a production build. Only has an effect with
# the embedded database, and only when the database has no other users.
# Do not enable this for a public deployment with real accounts.
# SEED_DEMO_DATA="false"
