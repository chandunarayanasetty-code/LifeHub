# LifeHub does not read environment variables yet. Phase 1 runs entirely on
# generated preview data. Copy this file to .env.local once the database and
# authentication phases begin.

# Phase 3 — PostgreSQL via Prisma
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lifehub?schema=public"

# Phase 4 — authentication
# AUTH_SECRET="generate with: openssl rand -base64 32"
# AUTH_URL="http://localhost:3000"

# Phase 6 — optional notification delivery
# RESEND_API_KEY="re_..."
