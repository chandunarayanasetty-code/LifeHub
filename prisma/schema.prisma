// LifeHub database schema (PostgreSQL).
//
// Local development runs this schema against an embedded PostgreSQL build
// (PGlite) through Prisma driver adapters — no database server is required.
// Set DATABASE_URL to a real PostgreSQL connection string in production and
// apply the migrations in prisma/migrations with `prisma migrate deploy`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  in_progress @map("in-progress")
  completed
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  critical
}

enum TransactionType {
  income
  expense
}

enum HabitFrequency {
  daily
  weekly
}

enum HabitIcon {
  activity
  book
  droplets
  code
  brain
}

enum AccentColor {
  violet
  emerald
  amber
  sky
  rose
}

enum GoalStatus {
  active
  completed
  archived
}

enum NotificationKind {
  deadline
  event
  goal
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  /// The demo account ships with clearly labelled sample records.
  isDemo       Boolean  @default(false)
  currency     String   @default("USD")
  timezone     String   @default("America/Los_Angeles")
  weekStartsOn Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions       Session[]
  tasks          Task[]
  events         CalendarEvent[]
  transactions   FinancialTransaction[]
  habits         Habit[]
  goals          Goal[]
  notes          Note[]
  notifications  Notification[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  /// SHA-256 hash of the random cookie token. The raw token is never stored.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Task {
  id          String       @id @default(cuid())
  userId      String
  title       String
  description String       @default("")
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  category    String
  tags        String[]     @default([])
  dueDate     DateTime
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model CalendarEvent {
  id          String      @id @default(cuid())
  userId      String
  title       String
  description String      @default("")
  start       DateTime
  end         DateTime
  allDay      Boolean     @default(false)
  location    String?
  color       AccentColor @default(violet)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
  @@map("calendar_events")
}

model FinancialTransaction {
  id            String          @id @default(cuid())
  userId        String
  type          TransactionType
  /// Amount in minor units (cents) to avoid floating-point rounding.
  amountCents   Int
  category      String
  description   String          @default("")
  date          DateTime
  paymentMethod String          @default("Card")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, type])
  @@map("financial_transactions")
}

model Habit {
  id        String         @id @default(cuid())
  userId    String
  name      String
  icon      HabitIcon      @default(activity)
  frequency HabitFrequency @default(daily)
  color     AccentColor    @default(emerald)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  completions HabitCompletion[]

  @@index([userId])
  @@map("habits")
}

model HabitCompletion {
  id      String   @id @default(cuid())
  habitId String
  /// Local calendar day in YYYY-MM-DD form. A day is either done or not.
  dateKey String   @db.VarChar(10)
  createdAt DateTime @default(now())

  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, dateKey])
  @@index([dateKey])
  @@map("habit_completions")
}

model Goal {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String     @default("")
  category    String
  current     Int        @default(0)
  target      Int
  unit        String     @default("")
  deadline    DateTime
  status      GoalStatus @default(active)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("goals")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @default("")
  tags      String[] @default([])
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, pinned])
  @@map("notes")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  /// Stable key so reminder sync can be idempotent (e.g. "task:<id>:due").
  dedupeKey   String
  title       String
  description String
  href        String
  kind        NotificationKind
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, read])
  @@map("notifications")
}
